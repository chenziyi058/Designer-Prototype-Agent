# Web
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Hosted runtime. Vercel requires a pooled Neon/Supabase PostgreSQL URL.
DEPLOYMENT_PLATFORM=vercel
DATABASE_URL=

# Local FastAPI only. When using the Python executor, set DATABASE_URL to:
# sqlite:///./data/designer-prototype-agent.db
PROJECTS_ROOT=./projects
CORS_ORIGINS=http://localhost:3000,http://localhost:3001,http://localhost:3002,http://localhost:5173
CORS_ORIGIN_REGEX=^https?://(localhost|127\.0\.0\.1)(:\d+)?$

# Model provider: mock or deepseek. mock runs without credentials.
MODEL_PROVIDER=mock
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_DEFAULT_MODEL=
DEEPSEEK_REASONING_MODEL=
DEEPSEEK_CODING_MODEL=
DEEPSEEK_REASONING_EFFORT=high
MODEL_TIMEOUT_SECONDS=120
MODEL_MAX_RETRIES=2
MODEL_TEMPERATURE=0.2
